{
  "name": "@teamisty/notification-service",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "jest --runInBand",
    "lint": "npm run prisma:generate && tsc --noEmit",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "amqplib": "^0.10.9",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "helmet": "latest",
    "pg": "^8.16.3",
    "prisma": "^7.10.1",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jest": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/supertest": "latest",
    "jest": "latest",
    "supertest": "latest",
    "ts-jest": "latest",
    "tsx": "latest",
    "typescript": "^5.9.3"
  }
}
