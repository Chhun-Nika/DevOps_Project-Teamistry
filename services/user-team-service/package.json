    "jsonwebtoken": "^9.0.3",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jest": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "latest",
    "@types/supertest": "latest",
    "jest": "latest",
    "prisma": "^7.10.1",
    "supertest": "latest",
    "ts-jest": "latest",
    "tsx": "latest",
    "typescript": "^5.9.3"
